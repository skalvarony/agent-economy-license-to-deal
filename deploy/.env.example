# Copy to .env and fill in. Nothing here goes in the repository.

# The shops answer at a.<DOMAIN>, b.<DOMAIN> and c.<DOMAIN>; the front page
# at <DOMAIN>. All four names must point at this machine.
DOMAIN=licensetodeal.app
# An older name to keep answering beside DOMAIN (optional).
ALT_DOMAIN=licensetodeal.duckdns.org
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=you@example.com

# Header value for merchant actions (cancel, refund, grant coins, ledger).
# Make one up: openssl rand -hex 24
SIMULATION_SECRET=

# Password of the demo account in every shop (demo@example.com).
DEMO_PASSWORD=

# Shops: 1 turns away unsigned agents. Keep it.
REQUIRE_SIGNATURES=1

# Payments. mock: a labelled simulation. stripe: Stripe with the keys below;
# test keys (sk_test_…, pk_test_…) move no money.
PAYMENT_RAIL=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
