# Copy to .env and fill in. Nothing here goes in the repository.

# The shops answer at a.<DOMAIN>, b.<DOMAIN>, c.<DOMAIN>; the agent at
# agent.<DOMAIN>. All four names must point at this machine.
DOMAIN=licensetodeal.app
# An older name to keep answering beside DOMAIN (optional).
ALT_DOMAIN=licensetodeal.duckdns.org
# The agent lives on its own name, apart from the shops' domain (a free
# DuckDNS name does). It must point at this machine too.
AGENT_ALVARO_HOST=ltd-agent-alvaro.duckdns.org
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=you@example.com

# Header value for merchant actions (cancel, refund, grant coins, ledger).
# Make one up: openssl rand -hex 24
SIMULATION_SECRET=

# Password of the demo account in every shop (demo@example.com).
DEMO_PASSWORD=

# The team's sign-in for the console, the venue and the agents' pages (the
# apps show a sign-in page and keep a session for a week). The hash comes from
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
# and every $ in it must be written as $$ here.
AGENT_USER=team
AGENT_PASSWORD_HASH=
# Each agent may have its person's own login instead ("user:hash"); the
# team's then no longer opens that agent. set-secrets.sh fills these.
LOGIN_USERS_ALVARO=

# The agent's brain. Empty: the scripted stand-in decides.
OPENAI_API_KEY=
AGENT_MODEL=gpt-5-mini
# Any OpenAI-compatible chat completions endpoint. OpenRouter:
# https://openrouter.ai/api/v1 with an OpenRouter key and one of its model
# ids (AGENT_MODEL=anthropic/claude-sonnet-4.5). Anthropic's compatibility
# layer: https://api.anthropic.com/v1 with AGENT_MODEL=claude-haiku-4-5-20251001
# (or a Sonnet). Groq: https://api.groq.com/openai/v1 with a Llama 3.3 70B.
OPENAI_BASE_URL=https://api.openai.com/v1
# The most tokens one answer may take. Answers are short; providers that
# bill up front (OpenRouter) refuse a request without a cap.
AGENT_MAX_TOKENS=1500
# A second model asked when the first fails for good on a request (after
# the retries). Empty: none. If that fails too, the scripted stand-in takes
# the turn, and says so.
AGENT_FALLBACK_MODEL=
# AGENT_BRAIN=scripted keeps the stand-in even with a key.
AGENT_BRAIN=

# Shops: 1 turns away unsigned agents. Keep it.
REQUIRE_SIGNATURES=1
# Also turn away signatures with no nonce (a copied request cannot be replayed).
REQUIRE_SIGNATURE_NONCE=1

# Telegram: a bot from @BotFather (/newbot). Empty: no Telegram.
# The person links their chat from the agent's page.
TELEGRAM_BOT_TOKEN_ALVARO=

# Voice: the phone number ElevenLabs answers for the agent, set up with
# deploy/elevenlabs-voice.py (see README). Empty: the page says "Not set up".
AGENT_PHONE_ALVARO=

# Payments. mock: a labelled simulation. stripe: Stripe with the keys below;
# test keys (sk_test_…, pk_test_…) move no money. With stripe, the agents
# pay with Stripe's test card: set the two AGENT_CARD_* lines as shown.
PAYMENT_RAIL=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# AGENT_CARD_HANDLER=stripe
# AGENT_CARD_TOKEN=pm_card_visa
